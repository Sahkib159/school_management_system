      <header class="field__label mb-2 d-flex align-items-center">
      <svg class="svg-inline--fa fa-tag fa-w-16 me-2 text-secondary" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="tag" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" data-fa-i2svg=""><path fill="currentColor" d="M0 252.118V48C0 21.49 21.49 0 48 0h204.118a48 48 0 0 1 33.941 14.059l211.882 211.882c18.745 18.745 18.745 49.137 0 67.882L293.823 497.941c-18.745 18.745-49.137 18.745-67.882 0L14.059 286.059A48 48 0 0 1 0 252.118zM112 64c-26.51 0-48 21.49-48 48s21.49 48 48 48 48-21.49 48-48-21.49-48-48-48z"></path></svg><!-- <i class="fas fa-tag me-2 text-secondary" aria-hidden="true"></i> Font Awesome fontawesome.com -->
      <span class="fw-bold">Image</span>
    </header>
  
            <div class="field__item" bis_skin_checked="1">
          <a href="https://library.iub.edu.bd/node/38367">  <img loading="eager" srcset="/sites/default/files/styles/max_325x325/public/2026-07/crossref.jpeg?itok=A_vNspKv 325w, /sites/default/files/styles/max_650x650/public/2026-07/crossref.jpeg?itok=XtchBPew 597w" sizes="(min-width: 1290px) 1290px, 100vw" width="325" height="182" src="./library_files/crossref.jpeg" alt="crossref" typeof="foaf:Image">

</a>

      </div>
      </div>

      </div>

  <div class="news-body" bis_skin_checked="1">
    <div class="news-date text-muted" bis_skin_checked="1">July 19, 2026</div>
    <h5 class="news-title mb-2"><a href="https://library.iub.edu.bd/node/38367">
